 "segments": [
  {
   "name": "opening",
   "lines": [
    {
     "spk": "A",
     "text": "好，我們開始今天的週會，今天有幾個議題要討論。"
    }
   ]
  },
  {
   "name": "T1供應商",
   "lines": [
    {
     "spk": "B",
     "text": "第一個議題是供應商。新光材料的電源晶片交期延到十月十日，比原本晚了七天。"
    },
    {
     "spk": "C",
     "text": "替代料已經在驗證，目前良率是百分之九十。"
    },
    {
     "spk": "A",
     "text": "請李協理跟對方確認，週五回報。"
    }
   ]
  },
  {
   "name": "T2上線",
   "lines": [
    {
     "spk": "C",
     "text": "第二個議題是新版 ERP系統上線。資料轉換已經完成百分之八十五。"
    },
    {
     "spk": "A",
     "text": "正式切換訂在二月三日晚上，預計停機三小時。"
    },
    {
     "spk": "B",
     "text": "李協理負責通知所有使用者。"
    }
   ]
  },
  {
   "name": "T3工安",
   "lines": [
    {
     "spk": "B",
     "text": "第三個議題是工安。上週三樓產線發生一起小事故，沒有人受傷。"
    },
    {
     "spk": "A",
     "text": "已經加裝四支警示燈，並在六月十四日前完成全員複訓。"
    },
    {
     "spk": "C",
     "text": "負責人是張工程師。"
    }
   ]
  },
  {
   "name": "T4預算",
   "lines": [
    {
     "spk": "A",
     "text": "第四個議題是預算。明年品保部的預算是兩百萬元，其中硬體佔三十萬元。"
    },
    {
     "spk": "B",
     "text": "人力的部分要再增加二位工程師。"
    },
    {
     "spk": "A",
     "text": "預算表請劉課長在十月七日前送到財務部。"
    }
   ]
  },
  {
   "name": "T5訂單",
   "lines": [
    {
     "spk": "A",
     "text": "第五個議題是客戶訂單。台中的聯華精密希望在三月十七日前拿到五百台車用鏡頭樣品。"
    },
    {
     "spk": "B",
     "text": "他們對單價有意見，希望降價百分之十。"
    },
    {
     "spk": "C",
     "text": "我建議先簽六十台的試單，價格維持新報價，等試用結果再談。"
    },
    {
     "spk": "A",
     "text": "同意，這件事由王經理負責，週五前回覆客戶。"
    }
   ]
  },
  {
   "name": "T6韌體",
   "lines": [
    {
     "spk": "B",
     "text": "第六個議題是工業閘道器的韌體更新。目前回報的問題是藍牙斷線，修正版預計六月二十五日上線。"
    },
    {
     "spk": "A",
     "text": "測試的部分請黃專員安排，至少要做十輪回歸測試。"
    },
    {
     "spk": "C",
     "text": "上線前先在五十台設備上試跑三天，沒有問題再全面更新。"
    }
   ]
  },
  {
   "name": "T7招募",
   "lines": [
    {
     "spk": "C",
     "text": "第七個議題是招募。業務部目前缺二個職缺，已經面試了十五位候選人。"
    },
    {
     "spk": "A",
     "text": "下週會再安排四場面試，由王經理主持。"
    },
    {
     "spk": "B",
     "text": "希望在十二月三日前完成報到。"
    }
   ]
  },
  {
   "name": "closing",
   "lines": [
    {
     "spk": "A",
     "text": "好，最後總結一下。"
    },
    {
     "spk": "B",
     "text": "供應商方面，決議是替代料持續驗證，待辦事項是李協理週五回報新光材料的交期。"
    },
    {
     "spk": "C",
     "text": "預算方面，決議是品保部明年預算兩百萬元，待辦事項是劉課長送預算表。"
    },
    {
     "spk": "B",
     "text": "招募方面，決議是十二月三日前完成報到，待辦事項是王經理主持面試。"
    },
    {
     "spk": "A",
     "text": "今天就到這裡，謝謝大家。"
    }
   ]
  }
 ],
