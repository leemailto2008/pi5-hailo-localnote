 "segments": [
  {
   "name": "opening",
   "lines": [
    {
     "spk": "A",
     "text": "好，我們開始今天的週會，今天有幾個議題要討論。"
    }
   ]
  },
  {
   "name": "T1韌體",
   "lines": [
    {
     "spk": "B",
     "text": "第一個議題是電源供應器的韌體更新。目前回報的問題是韌體當機，修正版預計十月十一日上線。"
    },
    {
     "spk": "A",
     "text": "測試的部分請李協理安排，至少要做五輪回歸測試。"
    },
    {
     "spk": "C",
     "text": "上線前先在一百台設備上試跑三天，沒有問題再全面更新。"
    }
   ]
  },
  {
   "name": "T2庫存",
   "lines": [
    {
     "spk": "A",
     "text": "第二個議題是庫存。電源供應器目前庫存一千五百台，大約可以撐四週。"
    },
    {
     "spk": "B",
     "text": "下一批三千台預計一月三日到貨。"
    },
    {
     "spk": "C",
     "text": "如果台南的訂單提前，要請張工程師調貨。"
    }
   ]
  },
  {
   "name": "T3訂單",
   "lines": [
    {
     "spk": "A",
     "text": "第三個議題是客戶訂單。新竹的宏遠科技希望在九月十七日前拿到一百二十台車用鏡頭樣品。"
    },
    {
     "spk": "B",
     "text": "他們對單價有意見，希望降價百分之十。"
    },
    {
     "spk": "C",
     "text": "我建議先簽八十台的試單，價格維持新報價，等試用結果再談。"
    },
    {
     "spk": "A",
     "text": "同意，這件事由張工程師負責，週五前回覆客戶。"
    }
   ]
  },
  {
   "name": "T4品質",
   "lines": [
    {
     "spk": "A",
     "text": "第四個議題是品質異常。上個月溫控模組的客訴有九件，主要是外殼刮傷。"
    },
    {
     "spk": "B",
     "text": "產線已經加開一站檢查，不良率從百分之五降到百分之一。"
    },
    {
     "spk": "C",
     "text": "劉課長會在九月十五日前提出改善報告。"
    }
   ]
  },
  {
   "name": "T5展覽",
   "lines": [
    {
     "spk": "C",
     "text": "第五個議題是行銷活動。八月二十四日在新竹有一場展覽，攤位費十五萬元。"
    },
    {
     "spk": "A",
     "text": "預計展出六款產品，需要三位同仁支援。"
    },
    {
     "spk": "B",
     "text": "文宣請許經理負責，週五前交初稿。"
    }
   ]
  },
  {
   "name": "T6招募",
   "lines": [
    {
     "spk": "C",
     "text": "第六個議題是招募。業務部目前缺二個職缺，已經面試了十二位候選人。"
    },
    {
     "spk": "A",
     "text": "下週會再安排六場面試，由黃專員主持。"
    },
    {
     "spk": "B",
     "text": "希望在十一月十九日前完成報到。"
    }
   ]
  },
  {
   "name": "T7出差",
   "lines": [
    {
     "spk": "A",
     "text": "第七個議題是出差安排。吳副理下個月要去新加坡拜訪台揚通訊，行程三天。"
    },
    {
     "spk": "B",
     "text": "預算抓八萬元，機票已經訂好了。"
    },
    {
     "spk": "C",
     "text": "回來後在九月二日的週會上報告。"
    }
   ]
  },
  {
   "name": "T8上線",
   "lines": [
    {
     "spk": "C",
     "text": "第八個議題是倉儲管理系統上線。資料轉換已經完成百分之九十五。"
    },
    {
     "spk": "A",
     "text": "正式切換訂在九月四日晚上，預計停機二小時。"
    },
    {
     "spk": "B",
     "text": "吳副理負責通知所有使用者。"
    }
   ]
  },
  {
   "name": "T9訓練",
   "lines": [
    {
     "spk": "B",
     "text": "第九個議題是教育訓練。九月七日有一場品質工程課程，名額三十人。"
    },
    {
     "spk": "C",
     "text": "目前已經報名二十五人，還剩五個名額。"
    },
    {
     "spk": "A",
     "text": "請各部門在週四前把名單交給黃專員。"
    }
   ]
  },
  {
   "name": "T10預算",
   "lines": [
    {
     "spk": "A",
     "text": "第十個議題是預算。明年生產部的預算是兩百萬元，其中硬體佔四十萬元。"
    },
    {
     "spk": "B",
     "text": "人力的部分要再增加四位工程師。"
    },
    {
     "spk": "A",
     "text": "預算表請王經理在六月十四日前送到財務部。"
    }
   ]
  },
  {
   "name": "T11工安",
   "lines": [
    {
     "spk": "B",
     "text": "第十一個議題是工安。上週三樓產線發生一起小事故，沒有人受傷。"
    },
    {
     "spk": "A",
     "text": "已經加裝八支警示燈，並在九月十日前完成全員複訓。"
    },
    {
     "spk": "C",
     "text": "負責人是劉課長。"
    }
   ]
  },
  {
   "name": "T12供應商",
   "lines": [
    {
     "spk": "B",
     "text": "第十二個議題是供應商。聯華精密的外殼模具交期延到三月十五日，比原本晚了十四天。"
    },
    {
     "spk": "C",
     "text": "替代料已經在驗證，目前良率是百分之九十五。"
    },
    {
     "spk": "A",
     "text": "請林主任跟對方確認，週五回報。"
    }
   ]
  },
  {
   "name": "T13韌體",
   "lines": [
    {
     "spk": "B",
     "text": "第十三個議題是車用鏡頭的韌體更新。目前回報的問題是韌體當機，修正版預計四月二十六日上線。"
    },
    {
     "spk": "A",
     "text": "測試的部分請楊工程師安排，至少要做五輪回歸測試。"
    },
    {
     "spk": "C",
     "text": "上線前先在三十台設備上試跑三天，沒有問題再全面更新。"
    }
   ]
  },
