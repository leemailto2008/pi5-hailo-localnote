 "segments": [
  {
   "name": "opening",
   "lines": [
    {
     "spk": "A",
     "text": "好，我們開始今天的週會，今天有幾個議題要討論。"
    }
   ]
  },
  {
   "name": "T1招募",
   "lines": [
    {
     "spk": "C",
     "text": "第一個議題是招募。資訊部目前缺五個職缺，已經面試了八位候選人。"
    },
    {
     "spk": "A",
     "text": "下週會再安排四場面試，由許經理主持。"
    },
    {
     "spk": "B",
     "text": "希望在十一月二十八日前完成報到。"
    }
   ]
  },
  {
   "name": "T2品質",
   "lines": [
    {
     "spk": "A",
     "text": "第二個議題是品質異常。上個月工業閘道器的客訴有十八件，主要是外殼刮傷。"
    },
    {
     "spk": "B",
     "text": "產線已經加開一站檢查，不良率從百分之四降到百分之一。"
    },
    {
     "spk": "C",
     "text": "黃專員會在二月十五日前提出改善報告。"
    }
   ]
  },
  {
   "name": "closing",
   "lines": [
    {
     "spk": "A",
     "text": "好，最後總結一下。"
    },
    {
     "spk": "B",
     "text": "招募方面，決議是十一月二十八日前完成報到，待辦事項是許經理主持面試。"
    },
    {
     "spk": "C",
     "text": "品質方面，決議是產線加開一站檢查，待辦事項是黃專員在二月十五日前提出改善報告。"
    },
    {
     "spk": "A",
     "text": "今天就到這裡，謝謝大家。"
    }
   ]
  }
 ],
