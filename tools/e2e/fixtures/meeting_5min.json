 "segments": [
  {
   "name": "opening",
   "lines": [
    {
     "spk": "A",
     "text": "好，我們開始今天的週會，今天有幾個議題要討論。"
    }
   ]
  },
  {
   "name": "T1出差",
   "lines": [
    {
     "spk": "A",
     "text": "第一個議題是出差安排。吳副理下個月要去東京拜訪東元工業，行程四天。"
    },
    {
     "spk": "B",
     "text": "預算抓十二萬元，機票已經訂好了。"
    },
    {
     "spk": "C",
     "text": "回來後在六月十五日的週會上報告。"
    }
   ]
  },
  {
   "name": "T2工安",
   "lines": [
    {
     "spk": "B",
     "text": "第二個議題是工安。上週地下停車場發生一起小事故，沒有人受傷。"
    },
    {
     "spk": "A",
     "text": "已經加裝八支警示燈，並在三月二十六日前完成全員複訓。"
    },
    {
     "spk": "C",
     "text": "負責人是許經理。"
    }
   ]
  },
  {
   "name": "T3展覽",
   "lines": [
    {
     "spk": "C",
     "text": "第三個議題是行銷活動。四月十二日在台中有一場展覽，攤位費十五萬元。"
    },
    {
     "spk": "A",
     "text": "預計展出八款產品，需要三位同仁支援。"
    },
    {
     "spk": "B",
     "text": "文宣請劉課長負責，週一前交初稿。"
    }
   ]
  },
  {
   "name": "T4韌體",
   "lines": [
    {
     "spk": "B",
     "text": "第四個議題是溫控模組的韌體更新。目前回報的問題是韌體當機，修正版預計三月二十八日上線。"
    },
    {
     "spk": "A",
     "text": "測試的部分請許經理安排，至少要做三輪回歸測試。"
    },
    {
     "spk": "C",
     "text": "上線前先在一百台設備上試跑三天，沒有問題再全面更新。"
    }
   ]
  },
  {
   "name": "T5供應商",
   "lines": [
    {
     "spk": "B",
     "text": "第五個議題是供應商。永豐光電的電源晶片交期延到六月二十三日，比原本晚了七天。"
    },
    {
     "spk": "C",
     "text": "替代料已經在驗證，目前良率是百分之八十五。"
    },
    {
     "spk": "A",
     "text": "請王經理跟對方確認，週五回報。"
    }
   ]
  },
  {
   "name": "T6訂單",
   "lines": [
    {
     "spk": "A",
     "text": "第六個議題是客戶訂單。桃園的華新機電希望在二月二十五日前拿到一百二十台智慧電錶樣品。"
    },
    {
     "spk": "B",
     "text": "他們對單價有意見，希望降價百分之八。"
    },
    {
     "spk": "C",
     "text": "我建議先簽五十台的試單，價格維持新報價，等試用結果再談。"
    },
    {
     "spk": "A",
     "text": "同意，這件事由黃專員負責，週一前回覆客戶。"
    }
   ]
  },
  {
   "name": "T7招募",
   "lines": [
    {
     "spk": "C",
     "text": "第七個議題是招募。業務部目前缺三個職缺，已經面試了十二位候選人。"
    },
    {
     "spk": "A",
     "text": "下週會再安排四場面試，由劉課長主持。"
    },
    {
     "spk": "B",
     "text": "希望在八月二十六日前完成報到。"
    }
   ]
  },
  {
   "name": "T8庫存",
   "lines": [
    {
     "spk": "A",
     "text": "第八個議題是庫存。智慧電錶目前庫存一千二百台，大約可以撐四週。"
    },
    {
     "spk": "B",
     "text": "下一批五百台預計二月七日到貨。"
    },
    {
     "spk": "C",
     "text": "如果桃園的訂單提前，要請蔡組長調貨。"
    }
   ]
  },
  {
   "name": "T9訓練",
   "lines": [
    {
     "spk": "B",
     "text": "第九個議題是教育訓練。五月二十五日有一場品質工程課程，名額二十人。"
    },
    {
     "spk": "C",
     "text": "目前已經報名十五人，還剩五個名額。"
    },
    {
     "spk": "A",
     "text": "請各部門在週二前把名單交給李協理。"
    }
   ]
  },
  {
   "name": "T10上線",
   "lines": [
    {
     "spk": "C",
     "text": "第十個議題是客服工單系統上線。資料轉換已經完成百分之八十。"
    },
    {
     "spk": "A",
     "text": "正式切換訂在五月二十一日晚上，預計停機四小時。"
    },
    {
     "spk": "B",
     "text": "吳副理負責通知所有使用者。"
    }
   ]
  },
  {
   "name": "T11品質",
   "lines": [
    {
     "spk": "A",
     "text": "第十一個議題是品質異常。上個月車用鏡頭的客訴有十八件，主要是接觸不良。"
    },
    {
     "spk": "B",
     "text": "產線已經加開一站檢查，不良率從百分之三降到百分之一。"
    },
    {
     "spk": "C",
     "text": "許經理會在五月二十五日前提出改善報告。"
    }
   ]
  },
  {
   "name": "T12預算",
   "lines": [
    {
     "spk": "A",
     "text": "第十二個議題是預算。明年資訊部的預算是一百二十萬元，其中硬體佔四十萬元。"
    },
    {
     "spk": "B",
     "text": "人力的部分要再增加二位工程師。"
    },
    {
     "spk": "A",
     "text": "預算表請楊工程師在一月十四日前送到財務部。"
    }
   ]
  },
  {
   "name": "T13出差",
   "lines": [
    {
     "spk": "A",
     "text": "第十三個議題是出差安排。李協理下個月要去新加坡拜訪台揚通訊，行程四天。"
    },
    {
     "spk": "B",
     "text": "預算抓十二萬元，機票已經訂好了。"
    },
    {
     "spk": "C",
     "text": "回來後在五月十四日的週會上報告。"
    }
   ]
  },
  {
   "name": "closing",
   "lines": [
    {
     "spk": "A",
     "text": "好，最後總結一下。"
    },
    {
     "spk": "B",
     "text": "出差方面，決議是吳副理出差東京，待辦事項是吳副理週會報告。"
    },
    {
     "spk": "C",
     "text": "招募方面，決議是八月二十六日前完成報到，待辦事項是劉課長主持面試。"
    },
    {
     "spk": "B",
     "text": "出差方面，決議是李協理出差新加坡，待辦事項是李協理週會報告。"
    },
    {
     "spk": "A",
     "text": "今天就到這裡，謝謝大家。"
    }
   ]
  }
 ],
