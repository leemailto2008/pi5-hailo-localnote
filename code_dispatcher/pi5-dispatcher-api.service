[Unit]
Description=Raspberry Pi 5 LLM Code Dispatcher API (FastAPI)
After=network.target redis-server.service ollama.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/code_dispatcher
Environment="XDG_RUNTIME_DIR=/run/user/1000"
Environment="PULSE_SERVER=unix:/run/user/1000/pulse/native"
ExecStart=/usr/bin/python3 -m uvicorn main:app --host 0.0.0.0 --port 80
Restart=always
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
